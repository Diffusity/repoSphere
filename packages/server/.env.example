PORT=6020
# Local development
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/reposphere
# NeonDB (serverless PostgreSQL)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/neondb?ssl=require
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_HOURS=72
FRONTEND_URL=http://localhost:6021
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:6020/api/v1/auth/google/callback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=RepoSphere
OTP_EXPIRY_MINUTES=10
COOKIE_SECURE=false
AUTH_COOKIE_NAME=rs_token

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your_public_r2_url.com
# Optional: comma-separated browser origins for credentialed CORS (defaults to FRONTEND_URL)
# CORS_ORIGINS=http://localhost:6021,http://127.0.0.1:6021
